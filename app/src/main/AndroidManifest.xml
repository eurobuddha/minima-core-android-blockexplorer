<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Node-only: no INTERNET permission. All chain data comes from the local Minima Core node over
         the broadcast-Intent IPC. Package visibility lets us launch the node app + deliver targeted
         broadcasts. -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <!-- allowBackup=false: the whole apks/ fleet was scaffolded with allowBackup="true" and empty backup
         rules, so Android Auto Backup uploaded each app's entire data directory to the user's cloud and
         restored it on reinstall. Harmless-looking apps still carried the node pairing token, and a
         reinstall must be a true reset everywhere, not just in the apps holding keys.
         At stake here: only a theme preference — but the shared minima_api_prefs pairing token (myapp_uid) travelled too,
         and there is nothing here worth restoring, so backup buys the user nothing and costs a stale token -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Explorer"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
