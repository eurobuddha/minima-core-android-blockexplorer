<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   Nothing in this app needs to leave the device, and nothing here should survive a reinstall onto a node
   with different keys. allowBackup="false" already disables this; the excludes are explicit so the intent
   survives anyone flipping that flag back. What was being carried:
   only a theme preference — but the shared minima_api_prefs pairing token (myapp_uid) travelled too,
         and there is nothing here worth restoring, so backup buys the user nothing and costs a stale token
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
